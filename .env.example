# Copy to .env and adjust. (server.js reads plain environment variables; use a
# loader like `set -a; . ./.env; set +a` before `node server.js`, or set them
# inline. Nothing here is required to run locally.)

# Port to listen on
PORT=8787

# If set, clients must send  Authorization: Bearer <this value>
# Leave empty for open localhost use.
WRAPPER_API_KEY=

# Which engine the server starts on: claude | gemini | codex | qwen | glm | kimi
# (can also be switched live from the dashboard). Defaults to claude.
# WRAPPER_PROVIDER=claude

# Path to each provider's binary, if not on PATH. Only the active one is used.
# CLAUDE_BIN=claude
# GEMINI_BIN=gemini
# CODEX_BIN=codex
# QWEN_BIN=qwen
# GLM_BIN=zai
# KIMI_BIN=kimi

# Per-request timeout in milliseconds (applies to whichever provider is active)
CLAUDE_TIMEOUT_MS=180000
